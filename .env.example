# Copie para .env e ajuste.

# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://usuario:senha@host:5432/nome_do_banco?schema=public"

# Segredo do JWT (troque em produção)
JWT_SECRET="troque-este-segredo-em-producao"

# Porta da API
PORT=3334

# CORS — origens permitidas, separadas por vírgula. Vazio = libera todas (dev).
# Em produção, restrinja ao domínio do frontend, ex.:
#   CORS_ORIGIN=https://app.seu-dominio.com
CORS_ORIGIN=

# Banco do SAG — espelho de escolas/turmas/alunos (somente leitura na origem).
# Deixe vazio (ou com o placeholder de senha) para desativar a sincronização.
SAG_DATABASE_URL="postgresql://usuario:COLOQUE_A_SENHA_AQUI@host:5432/banco?sslmode=disable"

# Intervalo da sincronização automática do espelho, em minutos
SAG_SYNC_INTERVALO_MIN=30
